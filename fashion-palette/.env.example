SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fashionpalette.pk
SMTP_PASS=your-mailbox-password
EMAIL_FROM=Fashion Palette <info@fashionpalette.pk>
EMAIL_REPLY_TO=info@fashionpalette.pk
ADMIN_EMAIL=info@fashionpalette.pk

# Multi-currency display (B2). Optional — defaults to the free key-less
# open.er-api.com (base PKR). To use a keyed provider, set the full URL that
# returns { rates: { USD: ..., EUR: ... } } for base PKR.
# EXCHANGE_RATE_URL=https://v6.exchangerate-api.com/v6/YOUR_KEY/latest/PKR
